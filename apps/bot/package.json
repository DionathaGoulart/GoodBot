{
  "name": "@goodbot/bot",
  "version": "0.0.0",
  "private": true,
  "description": "Bot de moderação para Discord (discord.js v14)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodbot/db": "workspace:*",
    "@goodbot/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "safe-regex2": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
