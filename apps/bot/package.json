{
  "name": "@cobot/bot",
  "version": "0.0.0",
  "private": true,
  "description": "Bot de moderação para Discord (discord.js v14)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cobot/db": "workspace:*",
    "@cobot/shared": "workspace:*",
    "discord.js": "^14.27.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
