# ─────────────────────────────────────────────────────────────────────────────
# CoBot — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
# Token do bot (Developer Portal → Bot → Reset Token).
DISCORD_TOKEN=
# Application ID (Developer Portal → General Information).
DISCORD_CLIENT_ID=
# Client Secret (Developer Portal → OAuth2). Usado só pelo painel (Auth.js).
DISCORD_CLIENT_SECRET=
# ID do servidor em que o bot opera (single-server hoje). Snowflake como texto.
GUILD_ID=

# ── Banco de dados ───────────────────────────────────────────────────────────
# Postgres 16. Em dev, o infra/docker-compose.dev.yml sobe com estas credenciais.
DATABASE_URL=postgres://cobot:cobot@localhost:5432/cobot

# ── API interna (bot ⇄ painel) ───────────────────────────────────────────────
# Token compartilhado. Gere com: openssl rand -hex 32
INTERNAL_API_TOKEN=
# URL da API interna do bot vista pelo painel.
# Dev: http://localhost:3001 · Compose: http://bot:3001
INTERNAL_API_URL=http://localhost:3001

# ── Painel (Auth.js) ─────────────────────────────────────────────────────────
# Segredo para assinar o JWT de sessão (≥ 32 bytes). Gere com: openssl rand -base64 32
AUTH_SECRET=
# URL pública do painel. Dev: http://localhost:3000 · Prod: https://seu-dominio
AUTH_URL=http://localhost:3000

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# Nível do pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Fuso horário do processo (também usado nos embeds e stats).
TZ=America/Sao_Paulo
