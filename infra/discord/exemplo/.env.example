# Copie para .env nesta mesma pasta e preencha. O .env NUNCA é versionado.

# ID da guild (servidor do Discord). Clique com o botão direito no servidor
# com o Modo Desenvolvedor ligado > Copiar ID do servidor.
GUILD_ID=

# Seu ID de usuário no Discord. Toda mudança é assinada por ele e aparece no
# registro de auditoria. Precisa ser admin (de preferência dono) da guild.
ACTOR_ID=

# Onde a API do bot responde. Em dev, http://localhost:3001.
INTERNAL_API_URL=http://localhost:3001

# O mesmo INTERNAL_API_TOKEN do .env da raiz / da VM.
INTERNAL_API_TOKEN=
