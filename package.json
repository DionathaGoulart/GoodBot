{
  "name": "goodbot",
  "version": "1.0.1",
  "private": true,
  "description": "Bot de moderação para Discord + painel web (monorepo pnpm)",
  "license": "MIT",
  "author": "Dionatha Goulart",
  "homepage": "https://github.com/DionathaGoulart/Goodbot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DionathaGoulart/Goodbot.git"
  },
  "bugs": {
    "url": "https://github.com/DionathaGoulart/Goodbot/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "concurrently -n bot,web -c cyan,magenta \"pnpm --filter @goodbot/bot dev\" \"pnpm --filter @goodbot/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm --filter @goodbot/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "audit": "pnpm audit --audit-level high",
    "guild": "pnpm --filter @goodbot/guild-config guild",
    "db:generate": "pnpm --filter @goodbot/db db:generate",
    "db:migrate": "pnpm --filter @goodbot/db db:migrate",
    "docker:build": "docker build --platform linux/amd64 -f infra/docker/bot.Dockerfile -t goodbot-bot:local .",
    "docker:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
