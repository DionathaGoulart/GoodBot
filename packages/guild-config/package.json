{
  "name": "@goodbot/guild-config",
  "version": "0.0.0",
  "private": true,
  "description": "Guild como código: aplica um guild.yaml num servidor do Discord pela API do bot",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
