  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dotenv": "^17",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
