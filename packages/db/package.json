{
  "name": "@cobot/db",
  "version": "0.0.0",
  "private": true,
  "description": "Schema Drizzle, migrations e cliente Postgres",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
